# Install only selected CLI tools from the official Kali distribution.
ARG WORKBENCH_IMAGE=tinfoil-workbench-tools:1
FROM ${WORKBENCH_IMAGE} AS workbench
FROM kalilinux/kali-rolling@sha256:4be87f78671419c13dcf4f207ead1cfc0de178ea281b3f69c0f49b69ba4e79b1
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-venv python3-pip pipx git git-lfs ripgrep curl wget jq unzip zip rsync tree \
    build-essential clang cmake ninja-build pkg-config gdb autoconf automake libtool \
    procps file shellcheck ca-certificates nmap ncat dnsutils whois netcat-openbsd socat \
    tcpdump tshark openssl sqlmap nikto whatweb ffuf gobuster hydra john \
    && rm -rf /var/lib/apt/lists/*
# Keep the tool protocol and Node/npm identical to the development image.
COPY --from=workbench /usr/local/ /usr/local/
COPY --from=workbench /opt/workbench /opt/workbench
# Kali's Nmap file capabilities cannot be granted under the broker's empty
# capability bounding set. Strip them so explicit TCP connect scans can run.
RUN setcap -r /usr/lib/nmap/nmap \
    && printf '%s\n' '#!/bin/sh' 'exec /usr/lib/nmap/nmap --unprivileged "$@"' > /usr/local/bin/nmap \
    && chmod 755 /usr/local/bin/nmap
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/workbench/remote/container-tools.mjs"]
